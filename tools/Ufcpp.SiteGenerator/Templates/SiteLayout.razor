@namespace Ufcpp.SiteGenerator.Templates

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ccccff" />
    @if (NoIndex)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <title>@PageTitle</title>
    <link rel="stylesheet" href="/assets/css/site.css" />
    @if (CanonicalUrl is not null)
    {
        <link rel="canonical" href="@CanonicalUrl" />
    }
    @if (ShowRssFeed)
    {
        <link rel="alternate" type="application/rss+xml" title="++C++; // 未確認飛行 C Blog" href="/rssfeed.xml" />
    }
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <h1 class="site-brand">
                <a class="site-title" href="/">
                    <img class="site-logo"
                         src="/assets/images/sitelogo_l.jpg"
                         alt="++C++; // 未確認飛行 C" />
                </a>
            </h1>
            <a class="site-search-link" href="/search/">サイト内検索 <span aria-hidden="true">›</span></a>
        </div>
        <nav class="site-nav" aria-label="メインナビゲーション">
            <ul>
                <li><a href="/study/csharp/">C#</a></li>
                <li><a href="/study/dotnet/">.NET</a></li>
                <li><a href="/study/computer/">情報工学</a></li>
                <li><a href="/study/miscprog/">コンピューターその他</a></li>
                <li><a href="/study/math/">数学・物理</a></li>
                <li><a href="/blog/">ブログ</a></li>
            </ul>
        </nav>
    </header>

    <div class="site-body">
        <main class="site-main" id="main-content">
            <article class="content @ContentTypeClass">
                @if (TitleHtml is not null)
                {
                    @((MarkupString)TitleHtml)
                }
                @if (Breadcrumbs.Count > 1)
                {
                    <nav class="breadcrumbs" aria-label="パンくずリスト">
                        <ol itemscope="itemscope" itemtype="https://schema.org/BreadcrumbList">
                            @for (var index = 0; index < Breadcrumbs.Count; index++)
                            {
                                var item = Breadcrumbs[index];
                                var isCurrent = index == Breadcrumbs.Count - 1;
                                <li itemprop="itemListElement"
                                    itemscope="itemscope"
                                    itemtype="https://schema.org/ListItem">
                                    @if (isCurrent)
                                    {
                                        <span itemprop="name" aria-current="page">@item.Title</span>
                                    }
                                    else
                                    {
                                        <a href="@item.Url" itemprop="item">
                                            <span itemprop="name">@item.Title</span>
                                        </a>
                                    }
                                    <meta itemprop="position" content="@(index + 1)" />
                                </li>
                            }
                        </ol>
                    </nav>
                }
                @if (IsArticle && ShouldShowArticlePublishedDate(PublishedAt, UpdatedAt))
                {
                    <div class="article-meta">
                        <time datetime="@PublishedAt">@FormatArticleDate(PublishedAt)</time>@if (ShouldShowArticleUpdatedDate(PublishedAt, UpdatedAt))
                        {
                            <span> (Last updated:<time datetime="@UpdatedAt">@FormatArticleDate(UpdatedAt)</time>)</span>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(PublishedAt))
                {
                    <div class="entry-meta">
                        <span>公開: <time datetime="@PublishedAt">@FormatDate(PublishedAt)</time></span>
                        @if (UpdatedAt is not null)
                        {
                            <span>更新: <time datetime="@UpdatedAt">@FormatDate(UpdatedAt)</time></span>
                        }
                        @if (Tags.Count > 0)
                        {
                            <span class="entry-tags">
                                @foreach (var tag in Tags)
                                {
                                    <span class="entry-tag">@tag</span>
                                }
                            </span>
                        }
                    </div>
                }
                @if (TableOfContents.Count > 0)
                {
                    <nav class="toc sub-info-section" aria-label="目次">
                        <p class="sub-info-title">目次</p>
                        <TableOfContentsList Items="@TableOfContents" />
                    </nav>
                }
                @if (Keywords.Count > 0)
                {
                    <section class="keywords sub-info-section" aria-label="キーワード">
                        <p class="sub-info-title">キーワード</p>
                        <ul>
                            @foreach (var keyword in Keywords)
                            {
                                <li><a href="@keyword.Url">@keyword.Title</a></li>
                            }
                        </ul>
                    </section>
                }
                @if (IsArticle)
                {
                    <div class="article-body">
                        @((MarkupString)BodyHtml)
                    </div>
                }
                else
                {
                    @((MarkupString)BodyHtml)
                }
            </article>
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-footer-inner">
            <p>Copyright &copy; 2000&ndash;2026 ++C++; // 未確認飛行 C. All Rights Reserved.</p>
            <p class="site-footer-links">
                <a href="/about_me/">運営者について</a>
                &ensp;|&ensp;
                <a href="/about_site/">サイトについて</a>
                &ensp;|&ensp;
                <a href="/sitemap/">サイトマップ</a>
            </p>
        </div>
    </footer>
</body>
</html>

@code {
    [Parameter] public string PageTitle { get; set; } = "++C++; // 未確認飛行 C";
    [Parameter] public string? CanonicalUrl { get; set; }
    [Parameter] public string? TitleHtml { get; set; }
    [Parameter] public string BodyHtml { get; set; } = "";
    [Parameter] public string ContentTypeClass { get; set; } = "";
    [Parameter] public bool ShowRssFeed { get; set; }
    [Parameter] public bool NoIndex { get; set; }
    [Parameter] public bool IsArticle { get; set; }
    [Parameter] public IReadOnlyList<NavigationItem> Breadcrumbs { get; set; } = [];
    [Parameter] public IReadOnlyList<TableOfContentsItem> TableOfContents { get; set; } = [];
    [Parameter] public IReadOnlyList<NavigationItem> Keywords { get; set; } = [];
    [Parameter] public string? PublishedAt { get; set; }
    [Parameter] public string? UpdatedAt { get; set; }
    [Parameter] public IReadOnlyList<string> Tags { get; set; } = [];

    private static string FormatDate(string value) =>
        GetDatePart(value);

    private static string FormatArticleDate(string? value) =>
        GetDatePart(value).Replace('-', '/');

    private static bool ShouldShowArticlePublishedDate(
        string? publishedAt,
        string? updatedAt) =>
        !string.IsNullOrWhiteSpace(publishedAt)
        && !string.Equals(publishedAt, updatedAt, StringComparison.Ordinal);

    private static bool ShouldShowArticleUpdatedDate(
        string? publishedAt,
        string? updatedAt) =>
        !string.IsNullOrWhiteSpace(updatedAt)
        && !string.Equals(
            GetDatePart(publishedAt),
            GetDatePart(updatedAt),
            StringComparison.Ordinal);

    private static string GetDatePart(string? value) =>
        value is { Length: >= 10 } ? value[..10] : value ?? "";
}
