@namespace Ufcpp.SiteGenerator.Templates

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ccccff" />
    @if (NoIndex)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <title>@PageTitle</title>
    <link rel="stylesheet" href="/assets/css/site.css" />
    @if (CanonicalUrl is not null)
    {
        <link rel="canonical" href="@CanonicalUrl" />
    }
    @if (ShowRssFeed)
    {
        <link rel="alternate" type="application/rss+xml" title="++C++; // 未確認飛行 C Blog" href="/rssfeed.xml" />
    }
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <h1 class="site-brand">
                <a class="site-title" href="/">
                    <img class="site-logo"
                         src="/assets/images/sitelogo_l.jpg"
                         alt="++C++; // 未確認飛行 C" />
                </a>
            </h1>
            <a class="site-search-link" href="/search/">サイト内検索 <span aria-hidden="true">›</span></a>
        </div>
        <nav class="site-nav" aria-label="メインナビゲーション">
            <ul>
                <li><a href="/study/csharp/">C#</a></li>
                <li><a href="/study/dotnet/">.NET</a></li>
                <li><a href="/study/computer/">情報工学</a></li>
                <li><a href="/study/miscprog/">コンピューターその他</a></li>
                <li><a href="/study/math/">数学・物理</a></li>
                <li><a href="/blog/">ブログ</a></li>
            </ul>
        </nav>
    </header>

    <div class="site-body">
        <main class="site-main" id="main-content">
            <article class="content @ContentTypeClass">
                @if (PublishedAt is not null)
                {
                    <div class="entry-meta">
                        <span>公開: <time datetime="@PublishedAt">@FormatDate(PublishedAt)</time></span>
                        @if (UpdatedAt is not null)
                        {
                            <span>更新: <time datetime="@UpdatedAt">@FormatDate(UpdatedAt)</time></span>
                        }
                        @if (Tags.Count > 0)
                        {
                            <span class="entry-tags">
                                @foreach (var tag in Tags)
                                {
                                    <span class="entry-tag">@tag</span>
                                }
                            </span>
                        }
                    </div>
                }
                @((MarkupString)BodyHtml)
            </article>
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-footer-inner">
            <p>Copyright &copy; 2000&ndash;2026 ++C++; // 未確認飛行 C. All Rights Reserved.</p>
            <p class="site-footer-links">
                <a href="/about_me/">運営者について</a>
                &ensp;|&ensp;
                <a href="/about_site/">サイトについて</a>
                &ensp;|&ensp;
                <a href="/sitemap/">サイトマップ</a>
            </p>
        </div>
    </footer>
</body>
</html>

@code {
    [Parameter] public string PageTitle { get; set; } = "++C++; // 未確認飛行 C";
    [Parameter] public string? CanonicalUrl { get; set; }
    [Parameter] public string BodyHtml { get; set; } = "";
    [Parameter] public string ContentTypeClass { get; set; } = "";
    [Parameter] public bool ShowRssFeed { get; set; }
    [Parameter] public bool NoIndex { get; set; }
    [Parameter] public string? PublishedAt { get; set; }
    [Parameter] public string? UpdatedAt { get; set; }
    [Parameter] public IReadOnlyList<string> Tags { get; set; } = [];

    private static string FormatDate(string value) =>
        value.Length >= 10 ? value[..10] : value;
}
